<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/real_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REALSIGNAL"
            android:textColor="@color/real_green"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="NATIVE CAST SENDER"
            android:textColor="@color/real_text_muted"
            android:textSize="12sp"
            android:letterSpacing="0.12" />

        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/cast_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Choose a Cast device"
            android:mediaRouteTypes="user"
            android:visibility="visible" />

        <TextView
            android:id="@+id/cast_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/status_background"
            android:padding="14dp"
            android:textColor="@color/real_text"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/power_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:checked="true"
            android:text="POWER ON"
            android:textColor="@color/real_text"
            app:buttonTint="@color/real_green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="CHANNEL"
            android:textColor="@color/real_text_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/channel_input"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/input_background"
            android:inputType="number"
            android:maxLength="3"
            android:padding="14dp"
            android:text="2"
            android:textColor="@color/real_green"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/channel_down_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="CHANNEL −"
                android:textAllCaps="false" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/channel_up_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="CHANNEL +"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="TV REMOTE"
            android:textColor="@color/real_text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="TV NAVIGATION"
            android:textColor="@color/real_text_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <Button android:id="@+id/nav_up_button" android:layout_width="88dp" android:layout_height="48dp" android:text="▲" android:textAllCaps="false" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/nav_left_button" android:layout_width="88dp" android:layout_height="48dp" android:text="◀" android:textAllCaps="false" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/nav_select_button" android:layout_width="88dp" android:layout_height="48dp" android:text="SELECT" android:textAllCaps="false" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/nav_right_button" android:layout_width="88dp" android:layout_height="48dp" android:text="▶" android:textAllCaps="false" />
            </LinearLayout>

            <Button android:id="@+id/nav_down_button" android:layout_width="88dp" android:layout_height="48dp" android:text="▼" android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button android:id="@+id/guide_button" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="GUIDE" android:textAllCaps="false" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <Button android:id="@+id/menu_button" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="MENU" android:textAllCaps="false" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <Button android:id="@+id/back_button" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="BACK" android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button android:id="@+id/next_button" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="NEXT" android:textAllCaps="false" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <Button android:id="@+id/surf_button" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="SURF" android:textAllCaps="false" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <Button android:id="@+id/last_button" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="LAST" android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button android:id="@+id/volume_down_button" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="VOL −" android:textAllCaps="false" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <Button android:id="@+id/mute_button" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="MUTE" android:textAllCaps="false" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <Button android:id="@+id/volume_up_button" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="VOL +" android:textAllCaps="false" />
        </LinearLayout>

        <Button
            android:id="@+id/send_state_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="TUNE CHANNEL ON TV"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/open_web_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="OPEN REALSIGNAL WEB REMOTE"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="The Cast icon uses Android's native device discovery. If the list is empty, verify the phone and receiver are on the same non-guest Wi-Fi and that the receiver is a Google Cast target."
            android:textColor="@color/real_text_muted"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
