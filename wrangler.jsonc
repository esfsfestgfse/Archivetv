{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "ais-relay",
  "main": "afterglow_ais_relay_worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "kv_namespaces": [
    {
      "binding": "REALSIGNAL_QUEUE",
      "id": "8404a49b4d75470baeaab6e32fb99489"
    }
  ]
}
